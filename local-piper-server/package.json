{
  "name": "piper-tts-server",
  "version": "1.0.0",
  "description": "Local Express server that calls Piper TTS and returns WAV audio",
  "main": "server.js",
  "scripts": {
    "setup": "node setup.js",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "start:unix": "sh scripts/start-unix.sh",
    "tray": "node tray/piper-tray.js",
    "start:windows": "powershell -ExecutionPolicy Bypass -File scripts/start-windows.ps1",
    "start:windows:bg": "powershell -ExecutionPolicy Bypass -File scripts/start-background-windows.ps1",
    "stop:windows:bg": "powershell -ExecutionPolicy Bypass -File scripts/stop-background-windows.ps1",
    "start:windows:tray": "scripts\\start-piper-tray.bat",
    "install:windows:tray": "powershell -ExecutionPolicy Bypass -File scripts/install-tray-startup-windows.ps1",
    "uninstall:windows:tray": "powershell -ExecutionPolicy Bypass -File scripts/uninstall-tray-startup-windows.ps1"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "systray2": "^2.1.4"
  },
  "engines": {
    "node": ">=18"
  }
}
