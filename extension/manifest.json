{
  "manifest_version": 3,
  "name": "Local TTS Reader",
  "version": "0.6.1",
  "description": "Highlight text, right-click, and hear it read aloud using browser voice or local Piper TTS.",
  "permissions": [
    "contextMenus",
    "tts",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1:5050/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Local TTS Reader"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
