{
  "manifest_version": 3,
  "name": "Piper TTS",
  "version": "1.0.14",
  "description": "Highlight text, right-click, and hear it read aloud with local Piper voices — no cloud, no API keys.",
  "permissions": [
    "contextMenus",
    "tts",
    "storage",
    "tabs",
    "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1:5050/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Piper TTS"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "read-selection": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Read selected text or stop playback"
    },
    "pause-resume": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Pause or resume playback"
    }
  },
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png",
    "512": "icons/icon512.png"
  }
}
