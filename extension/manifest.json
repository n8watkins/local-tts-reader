{
  "manifest_version": 3,
  "name": "Local TTS Reader",
  "version": "0.9.0",
  "description": "Highlight text, right-click, and hear it read aloud using local Piper TTS — no cloud, no API keys.",
  "permissions": [
    "contextMenus",
    "tts",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1:5050/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Local TTS Reader"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
