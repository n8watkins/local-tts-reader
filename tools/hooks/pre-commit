#!/bin/sh
# Keep extension/dist in sync with extension/src.
#
# Chrome loads the bundled files in extension/dist directly, but they are built
# from extension/src by esbuild. Without this hook it's easy to edit a .jsx,
# forget to rebuild, and commit a stale bundle. This rebuilds and re-stages the
# bundles whenever a change that could affect them is part of the commit.
#
# Enabled with: git config core.hooksPath tools/hooks
set -e

# Skip the (small but non-zero) build cost unless the UI sources or the build
# tooling are actually part of this commit.
if git diff --cached --name-only \
    | grep -qE '^(extension/src/|tools/build-extension-ui\.mjs|package(-lock)?\.json)'; then

  if [ ! -d node_modules/esbuild ]; then
    # Refuse rather than exit 0: a UI-source change committed without rebuilding
    # would ship a stale extension/dist, which is exactly what this hook exists
    # to prevent. Force the developer to install deps so the bundles get rebuilt.
    echo "pre-commit: esbuild not installed — run 'npm install', then re-commit (refusing to commit a possibly-stale extension/dist)." >&2
    exit 1
  fi

  echo "pre-commit: rebuilding extension UI bundles…"
  npm run build --silent
  git add extension/dist
fi
